{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "include": [
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "VERSION",
    ".tool-versions",
    "onboard.sh",
    "mix.exs",
    "mix.lock",
    ".formatter.exs",
    ".credo.exs",
    "build_support/**",
    "config/**/*.{ex,exs}",
    "lib/**/*.{ex,exs}",
    "test/**/*.{ex,exs}",
    "guides/**/*.md",
    "docs/**/*.md",
    "assets/**/*.svg",
    "core/*/README.md",
    "core/*/CHANGELOG.md",
    "core/*/LICENSE",
    "core/*/assets/**/*.svg",
    "core/*/guides/**/*.md",
    "core/*/docs/**/*.md",
    "core/*/mix.exs",
    "core/*/mix.lock",
    "core/*/.formatter.exs",
    "core/*/.credo.exs",
    "core/*/config/**/*.{ex,exs}",
    "core/*/lib/**/*.{ex,exs}",
    "core/*/test/**/*.{ex,exs,mjs}",
    "core/*/priv/static/**/*.{js,ts}",
    "apps/*/README.md",
    "apps/*/CHANGELOG.md",
    "apps/*/LICENSE",
    "apps/*/assets/**/*.svg",
    "apps/*/guides/**/*.md",
    "apps/*/docs/**/*.md",
    "apps/*/mix.exs",
    "apps/*/mix.lock",
    "apps/*/.formatter.exs",
    "apps/*/.credo.exs",
    "apps/*/config/**/*.{ex,exs}",
    "apps/*/lib/**/*.{ex,exs}",
    "apps/*/test/**/*.{ex,exs,mjs}",
    "apps/*/priv/static/**/*.{js,ts}"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      "**/_build/**",
      "**/deps/**",
      "**/doc/**",
      "**/tmp/**",
      "**/dist/**",
      "**/fixtures/**",
      "**/node_modules/**",
      "repomix-output.*"
    ]
  }
}
